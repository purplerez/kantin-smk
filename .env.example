APP_NAME="KantinSMK Go"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kantinsmk_go
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Akun platform admin yang dibuat oleh seeder
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=admin@smkgo.id
ADMIN_PASSWORD=admin123

# Realtime (Laravel Reverb). Set BROADCAST_CONNECTION=log untuk fallback polling tanpa Reverb.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=kantinsmk
REVERB_APP_KEY=ganti-dengan-key-acak
REVERB_APP_SECRET=ganti-dengan-secret-acak
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
